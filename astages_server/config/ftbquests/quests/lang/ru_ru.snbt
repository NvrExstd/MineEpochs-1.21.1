	file.0000000000000001.title: "Эволюция 1.21.1"
	quest.004B5403D61D0130.quest_desc: ["Важный материал для создания продвинутых механизмов Mekanism."]
	quest.009EC1987237C132.quest_desc: ["Ультимативные машины войны"]
	quest.01B5BC2E8BA647EC.quest_desc: ["Элемент турбины Mekanism, который конденсирует пар обратно в воду внутри установки."]
	quest.0257BA1E7DC12E22.quest_desc: ["Основной рабочий компонент ядерного реактора, в котором ядерное топливо делится, выделяя тепло."]
	quest.027B821EA33DF05C.quest_desc: ["Вращающаяся часть, преобразующая энергию потока (пара, газа, жидкости) в механическое движение вала."]
	quest.02D5F992C54AA07D.quest_subtitle: "Отыщи крепость Незера"
	quest.02D5F992C54AA07D.title: "Чертоги страха"
	quest.02E4F8E7DB56E1CD.quest_desc: ["Реактивная энергия позволит преодолеть силу притяжения."]
	quest.02E4F8E7DB56E1CD.title: "Реактивная энергия!"
	quest.03584FF8FC50F45E.quest_desc: ["Главное топливо современности."]
	quest.03DA6EBFE452136A.quest_desc: [" Элемент для настройки и контроля работы механизмов."]
	quest.03E0EB7B40CDE846.quest_desc: ["Космическая электроника выступает главным компонентом космической промышленности."]
	quest.03E0EB7B40CDE846.title: "Безотказная электроника"
	quest.04272D50267FB07C.quest_desc: ["Используй энергию ветра, чтобы получить вращение для своих механизмов"]
	quest.04272D50267FB07C.quest_subtitle: "Скрафти парус мельницы"
	quest.04272D50267FB07C.title: "Энергия ветра"
	quest.04419EA76509E1D7.quest_desc: ["Цепной привод позволяет передавать вращение без изменения направления на большую длину"]
	quest.0492A42F290748B1.quest_desc: [
		"Дробильные колёса, поставленные совместно и вращающиеся встречно по отношению друг к другу, позволяют дробить руду"
		"чтобы делать добычу более эффективной. "
	]
	quest.04F35EA63FA1617E.quest_desc: [""]
	quest.04F35EA63FA1617E.quest_subtitle: "Собери сет железной брони"
	quest.04F35EA63FA1617E.title: "Миллиардер, плейбой, филантроп"
	quest.051D7AB22AD28AD4.quest_desc: ["Используется для производства предметов. Направление вращения пилы имеет значение относительно движения конвейера!"]
	quest.056EA5F1B4426E7F.quest_subtitle: "Создай предмет и достигни 50 уровня"
	quest.05EC80496C96F26D.quest_desc: [
		"Начальный резервуар для хранения жидкостей."
		"Может быть многократно улучшен."
	]
	quest.061915024FDB6EBE.quest_desc: ["Простой источник энергии, который превращает тепло в электричество."]
	quest.064D815D7B9414FF.quest_desc: [
		"Установка для переработки материалов и подготовки сплавов."
		"С её помощью можно получать более ценные ресурсы для дальнейшего развития."
		"Может быть улучшен."
	]
	quest.0994F9F379FC0CA2.quest_desc: ["Если я научусь управлять двигателями, это позволит сделать шаг в будущее."]
	quest.0994F9F379FC0CA2.title: "Будущее стало настоящим"
	quest.09F49912CD357868.quest_desc: ["Вход/выход реакторной структуры, через который подаётся топливо и выводится энергия или другие ресурсы."]
	quest.0A00BBD82CB71C51.quest_desc: ["Смотри руководство Create по добыче нефти."]
	quest.0A40E5628CE2BAAE.quest_subtitle: "Скрафти предмет"
	quest.0A4DBE88FDADEA0E.quest_desc: [
		"Сканер поверхности следует разместить на блоке машинного ввода."
		"При наличии нефти он покажет в каком именно чанке она находится. Следует учитывать, что центральная лампа, это текущий чанк, где размещён прибор."
	]
	quest.0A6FCEB8FCF25245.quest_desc: ["Стальные баки необходимы для дальнейшей работы с новыми жидкостями"]
	quest.0A8AB8BC88699453.quest_desc: ["Автономный активатор позволяет обрабатывать предметы так, будто бы это делает игрок. А также позволяет проводить последовательную сборку."]
	quest.0AAE547292D23575.quest_desc: ["Для подключения проводов следует использовать соединители. Их следует размещать на специально отмеченных местах на блоках механизмов. Обычно это оранжевый квадрат."]
	quest.0AAE547292D23575.title: "Кабельный ввод"
	quest.0AF3E589CC218C15.quest_desc: ["Лучше составить здесь карту, чтобы не заблудиться."]
	quest.0AF3E589CC218C15.title: "Волшебный путеводитель"
	quest.0B535BEFA09FD4D6.quest_desc: ["Но энергию нужно где-то хранить, верно?"]
	quest.0BA647301E9A6A0C.quest_desc: [
		"Самый важный прибор в электрике. Позволяет изучать подробные параметры сети при наводке на блок. "
		"(Следует снять очки из Create перед использованием)"
	]
	quest.0BA647301E9A6A0C.title: "Друг инженера"
	quest.0BF6EE3DD66941FD.quest_desc: ["Жидкости можно хранить в баке. Бак можно собрать в многоблочную структуру 2х2 и 3х3, а также неограниченное количество в высоту. Это позволит увеличить его ёмкость."]
	quest.0BF6EE3DD66941FD.quest_subtitle: "Скрафти жидкостный бак"
	quest.0C1BE1E4BACFF453.quest_desc: ["Механическая рука позволяет перемещать предметы с конвейеров и депо, а также размещать их на них же, а также в механические сборщики, что открывает способ полной автоматизации массового производства."]
	quest.0DC0581D6DC5F455.quest_desc: ["Установка, которая использует солнечное излучение для медленного создания нейтронных изотопов."]
	quest.0E9B7DDB7CF4AF94.quest_desc: ["Для ракеты следует сделать надёжную дверь"]
	quest.0E9B7DDB7CF4AF94.title: "Надёжный барьер"
	quest.0FB99914DAD79ACE.quest_desc: [""]
	quest.0FB99914DAD79ACE.quest_subtitle: "Собери сет алмазной брони"
	quest.0FB99914DAD79ACE.title: "Он сиял в этой чайхане так, как не сиял никто"
	quest.0FCEFE4D6792528A.quest_desc: ["Добыча нефти открывает новые возможности для производства топлива и двигателей внутреннего сгорания."]
	quest.0FCEFE4D6792528A.title: "Первая нефть!"
	quest.106D48E2DFD8157D.quest_desc: ["Жёрнов может быть полезен чтобы получить опредёленные ресурсы."]
	quest.1097B6BB35DE22D0.quest_desc: ["Титановые блоки хорошо подойдут как жаропрочный материал для полётов в космос."]
	quest.1097B6BB35DE22D0.title: "Обшивка ракеты"
	quest.1122CAA2E71A0E6A.quest_subtitle: "Освободи Энд"
	quest.1122CAA2E71A0E6A.title: "Последний из древних"
	quest.12BE43E115617362.quest_desc: ["Здесь моя фантазия как сборщика закончилась"]
	quest.12E3D84EB7C0A807.quest_desc: ["Блок, перенаправляющий и расщепляющий лазерный луч для построения разветвлённых лазерных систем."]
	quest.13E847517AFF5A3D.quest_desc: ["Полноценный электродвигатель!"]
	quest.14ECCFB71D937B4A.quest_subtitle: "Добудь древние обломки"
	quest.1607DC2417F67FF7.quest_desc: ["Блок, который объединяет несколько лазерных лучей в один более мощный импульс."]
	quest.165EDDE3D18423FD.quest_desc: ["Её называли горячей сестричкой Земли"]
	quest.165EDDE3D18423FD.title: "Богиня любви"
	quest.1724054C7D514B4A.quest_desc: ["Вентиль нужен для отключения потоков жидкости."]
	quest.1724054C7D514B4A.quest_subtitle: "Скрафти вентиль"
	quest.189A54B890655DE2.quest_desc: ["Кремний необходим для производства самой современной электроники!"]
	quest.18EC97E8F46598E1.quest_desc: ["Базовый материал, используемый для дальнейшей переработки."]
	quest.1A260F551DC72B6E.quest_desc: ["Сжатый натуральный газ может пригодиться в качестве топлива."]
	quest.1B2BB3C10C62C6B0.quest_desc: ["Измерительные индикаторы полезны для получения информации об электроустановках."]
	quest.1B2BB3C10C62C6B0.title: "Измерительная техника"
	quest.1C5057D200B6A276.quest_desc: [
		"Таких рамок всего 3 и отличаются они вместимостью. Фильтр нужен чтобы очищать выхлопы."
		"В качестве наполнителя бери листву для углерода, а шерсть для серы."
	]
	quest.1C5057D200B6A276.quest_subtitle: "Создай рамку фильтра"
	quest.1C5057D200B6A276.title: "Кажется дышать стало труднее..."
	quest.1CA5DA19D0DBA5E3.quest_desc: ["Осушитель предметов позволяет забирать жидкости из бытулочек, ведёр и тд. "]
	quest.1CA5DA19D0DBA5E3.quest_subtitle: "Скрафти осушитель"
	quest.1D8914568BB1B9D0.quest_desc: [
		"Простой канал для перемещения предметов между механизмами."
		"Может быть многократно улучшена."
	]
	quest.1F31E532C03BF16B.quest_desc: ["Чтобы продолжить открой портал в Энд и войди в него"]
	quest.1F31E532C03BF16B.quest_subtitle: "Время конца"
	quest.1F31E532C03BF16B.title: "И раздался рёв"
	quest.1F4D6DF3F841A522.quest_subtitle: "Сделай алмазный меч"
	quest.201BF2DB09DB15C1.quest_desc: ["Для производства плат космического уровня нужен гравер."]
	quest.201BF2DB09DB15C1.title: "Технологичное производство"
	quest.21FEC69B7FA8DE2D.quest_desc: ["Главный металл в Create, используется для большинства крафтов"]
	quest.21FEC69B7FA8DE2D.quest_subtitle: "Скрафти андезитовый сплав"
	quest.2232D432890ADEAC.quest_desc: ["Настоящее авиационное топливо!"]
	quest.22D187A119894088.quest_desc: ["Ресурсы Марса позволяют в совершенстве овладеть высокими технологиями"]
	quest.22D187A119894088.title: "Инопланетные технологии"
	quest.237C911496861691.quest_desc: ["Всполоха в горелке можно кормить горючими материалами, самый лучший вариант - это лава. Но Всполоховый торт заставит всполоха перегреться"]
	quest.237C911496861691.quest_subtitle: "Создай всполоховый торт"
	quest.23BAE2803C65B0D8.quest_desc: ["Ну это уже казик какой то. Сколько круток надо сделать чтобы выбить что-то хорошее?"]
	quest.24E3F722B9B7A660.quest_desc: ["Больше ротор = больше энергии!"]
	quest.24F4E4FB5D5D3693.quest_desc: ["Аналог горелки всполоха, но работающий на нефтепродуктах"]
	quest.2567FD3748E33D02.quest_desc: ["Нефть это ценный ресурс, а ценный ресурс надо защищать"]
	quest.2567FD3748E33D02.title: "WTF THE KILOMETER!?"
	quest.290D27F55F58D912.quest_desc: ["Используется в производственных цепочках Mekanism, например для получения полиэтилена и других компонентов."]
	quest.295100311BA41920.quest_subtitle: "Получи железный слиток"
	quest.295100311BA41920.title: "Первое железо"
	quest.29C52E5B09DF33F8.quest_subtitle: "Скрафти предмет"
	quest.29C52E5B09DF33F8.title: "Помайним?"
	quest.2A9352A0AEDC5BA3.quest_desc: ["Смотри руководство Create по добыче нефти."]
	quest.2B2536ABB36FFB2A.quest_desc: ["Улучшенная версия андезитового туннеля"]
	quest.2B2536ABB36FFB2A.quest_subtitle: "Скрафти латунный туннель"
	quest.2BDD3AF35BA04D77.quest_desc: ["В доменной печи можно получить сталь и жидкий кремний. Смотри руководство Create, чтобы выполнить многоблочную постройку."]
	quest.2C4A3C0FD86DBB6B.quest_desc: ["Позволяет получать больше полезного материала из того же объёма сырья."]
	quest.2D06BF0198DFA870.quest_desc: ["Используется как элемент трансмиссии в турбинных и энергетических цепочках, связывая роторы и валы."]
	quest.2D640B2EA6AC8C40.quest_desc: ["Пора покорять космос и строить мощные источники энергии"]
	quest.2DCAC5C43172E866.quest_subtitle: "Убей 128 Блейзов"
	quest.2DCAC5C43172E866.title: "Стержни будут полезны"
	quest.2E33ADCD6CBA7D33.quest_desc: ["Незаменимые компоненты для электронных технологий"]
	quest.2E33ADCD6CBA7D33.title: "Компонентная база"
	quest.2E472E5BBF1594E3.quest_desc: ["Трубу следует прокладывать начиная от месторождения в бедроке до самой поверхности земли."]
	quest.2EA6DAF99A3EB000.quest_desc: ["Очки просто необходимы для анализа работы твоих механизмов."]
	quest.2F079370E291705D.quest_desc: ["Машинный ввод необходим для работы некоторых устройств, преобразуя энергию вращения."]
	quest.2F2007DF318933E5.quest_desc: ["Бур может добывать блоки, что полезно для такого механизма как генератор булыжника. Ведь булыжник = железо при правильной обработке."]
	quest.2F4CFD50C93C4EBA.quest_desc: ["Воронка, но лучше, быстрее и вместительнее"]
	quest.2F4CFD50C93C4EBA.quest_subtitle: "Скрафти жёлоб"
	quest.3147EE277F60F977.quest_desc: ["Механизм, который разделяет жидкость на отдельные химические компоненты."]
	quest.31E16553A9C2E458.quest_desc: ["Печатные платы позволяют встать на порог будущего всей техники"]
	quest.321F6E84F666BA8E.quest_desc: ["Используется как основа для дальнейшего развития и улучшения энергетической системы."]
	quest.3314F0835BCF9927.quest_subtitle: "Скрафти предмет"
	quest.3465CBA99D7413EA.quest_desc: [""]
	quest.3465CBA99D7413EA.quest_subtitle: "Собери сет золотой брони"
	quest.3465CBA99D7413EA.title: "Цыганей обворовал?"
	quest.34F1FB4DA7827D2B.quest_subtitle: "Скрафти предмет и собери ресурсы"
	quest.3516FB3FCAA99142.quest_desc: ["Помпа позволяет перемещать жидкости по трубам. На помпе есть стрелки, указывающие направление потока. Его можно изменить гаечным ключом."]
	quest.3516FB3FCAA99142.quest_subtitle: "Скрафти механическую помпу"
	quest.361A06534BB7DB14.quest_desc: ["Хранилище предметов это огромный, но компактный склад, однако из него нельзя вручную вытащить предметы. Используй шлюзы."]
	quest.361A06534BB7DB14.quest_subtitle: "Скрафти хранилище предметов"
	quest.378A12AE2DC37A07.quest_desc: ["Отлично подходит для производства битума, который превратится в асфальт, а также резины."]
	quest.3793D43BC85BB597.quest_subtitle: "Убей 12 Визеров"
	quest.3793D43BC85BB597.title: "А вот и первый босс"
	quest.379B6F5C66B99B74.quest_desc: [
		"Первые магниты получить тяжело. Не стоит терять первые 16 слитков до крафта поляризатора. "
		"Но если вдруг потерялись, попробуй кинуть заготовки рядом с громоотводом во время грозы."
	]
	quest.3897B184FE8DE840.quest_desc: ["Угловая передача позволяет изменить направление валов."]
	quest.3A0094E7A927E1A5.quest_desc: ["Химический смешиватель - мультизадачная многоблочная структура. Состав её модулей влияет на то, какую функцию она выполняет."]
	quest.3B52FF703FA3DD5B.quest_desc: ["Поймай меня, если сможешь."]
	quest.3B52FF703FA3DD5B.title: "Самый быстрый из планет"
	quest.3B6033FAED28429B.quest_desc: ["Для продолжения необходимо скрафтить сборщик, рецепт которого усложнён"]
	quest.3B6033FAED28429B.quest_subtitle: "Открой для себя инженерию"
	quest.3B6033FAED28429B.title: "Я могу всё!"
	quest.3BF48A51ABD63250.quest_desc: [
		"Иногда дымоход не очень удобен, если печей много. Воздуховод позволяет выводить дым горизонтально. "
		"Но обязательно присоедини насос, а затем активируй его. Насос начнёт откачивать дым из всей системы труб."
	]
	quest.3BF48A51ABD63250.quest_subtitle: "Создай модули вентиляции"
	quest.3BF48A51ABD63250.title: "Продвинутая вентиляция"
	quest.3D9AD1049B1CD213.quest_desc: ["Депо задерживает предметы, которые попадают на него. Предмет достаточно всего лишь выбросить на поверхность."]
	quest.3D9AD1049B1CD213.quest_subtitle: "Скрафти Депо"
	quest.3D9AD1049B1CD213.title: "Предметная логистика"
	quest.3DCD0F6756ED855E.quest_desc: ["Робит — механический компаньон из Mekanism, который может выполнять роль печи, верстака, наковальни и дополнительного сундука."]
	quest.3E00475FA68C8ADF.quest_desc: ["Данная книга задач поможет разобраться в развитии эпох, следуй указаниям и развивайся."]
	quest.3E00475FA68C8ADF.quest_subtitle: "Нажми на галочку чтобы продолжить"
	quest.3E1FB08D111B6AA7.quest_subtitle: "Скрафти фильтр атрибутов"
	quest.3E1FB08D111B6AA7.title: "Продвинутая логистика"
	quest.3EEE80423FB71556.quest_subtitle: "Скрафти предмет и собери ресурсы"
	quest.3F30B565D8D83E39.quest_subtitle: "Убей 128 визер-скелетов"
	quest.3F30B565D8D83E39.title: "Подсушился к лету?"
	quest.3F7D968CD4029CAC.quest_desc: ["Умные трубы могут регулировать поток жидкостей по типам."]
	quest.3F7D968CD4029CAC.quest_subtitle: "Скрафти умную жидкостную трубу"
	quest.3FA4AE284CAE637E.quest_desc: ["Мощный энергозависимый инструмент, объединяющий функции кирки, лопаты, меча и топора."]
	quest.3FD6CF75B14220CA.quest_desc: ["Полёт на луну позволил развить космические технологии и использовать новые материалы."]
	quest.3FD6CF75B14220CA.title: "Научное открытие!"
	quest.406B82016999728D.quest_desc: [""]
	quest.406B82016999728D.quest_subtitle: "Собери сет кожаной брони"
	quest.406B82016999728D.title: "LeatherMen"
	quest.40E93C4EA9CFACF7.quest_desc: ["Для наполнения предметов кислородом необходим специальный механизм."]
	quest.40E93C4EA9CFACF7.title: "Подзаправимся?"
	quest.418E33289792E101.quest_desc: ["Основа современных механизмов"]
	quest.41EB4B8E9BF3E7D0.quest_subtitle: "Скрафти предмет"
	quest.41EB4B8E9BF3E7D0.title: "В этом есть логика"
	quest.42429B169DE0C855.quest_desc: ["Ракетное топливо можно преобразовывать во вращение, всё как мы любим."]
	quest.42429B169DE0C855.title: "Новое - хорошо забытое старое"
	quest.42A47565CCB4D106.quest_desc: ["Незаменимая машинка для производства электронных компонентов"]
	quest.42A47565CCB4D106.title: "Намоточный станок"
	quest.434C1AFCEC185095.quest_desc: ["Элементы ядерного реактора, регулирующие интенсивность реакции за счёт поглощения нейтронов."]
	quest.43CC1864268D37DA.quest_desc: [
		"Держатель электродов позволяет использовать их для производства алюминия методом электролиза."
		"А также производства стали при помощи графитовых электродов, образуя аналог доменной печи."
	]
	quest.4439DD4EA55EC57D.quest_desc: ["Для продвижения необходимо найти портал в Крепости"]
	quest.4439DD4EA55EC57D.quest_subtitle: "Отыщи следы ушедшей цивилизации"
	quest.4439DD4EA55EC57D.title: "Кажется этот мир не единственный..."
	quest.450E67EA3C746D04.quest_desc: ["Коксовый уголь требуется для производства стали и других компонентов в промышленных масштабах"]
	quest.45931CFD9BC64657.quest_desc: ["Позволяет получать больше полезных ресурсов на раннем этапе переработки."]
	quest.459AD78C9BB031BF.quest_desc: ["Устройство, снижающее или перераспределяющее давление в системе."]
	quest.46F3279AE362EA7A.quest_desc: [
		"Вентилятор позволяет управлять потоком воздуха. Направление вращения имеет значение!"
		"Поставив вентилятор напротив лавы, костра, воды или костра душ можно получить новые методы обработки материалов."
	]
	quest.474BACA5011926AA.quest_desc: ["Маленький шаг для человека, но огромный для человечества."]
	quest.474BACA5011926AA.title: "Ну что, поехали!"
	quest.483938664601616F.quest_desc: ["Позволяет смешивать предметы в &nчаше&r, в некоторых случаях требуется источник нагрева."]
	quest.48A9DBB029677070.quest_desc: ["Высоконаправленный источник энергии, используемый для точного разрушения, обработки или автоматизации."]
	quest.48D1371A43C8F3EE.quest_desc: ["На некоторых планетах может быть слишком холодно или слишком жарко. Эта проблема решается терморегулятором."]
	quest.48D1371A43C8F3EE.title: "Микроклимат"
	quest.495E4DC3E5C3CDF1.quest_desc: [
		"Берсерк...       "
		""
		"                                              Берсерк."
	]
	quest.495E4DC3E5C3CDF1.quest_subtitle: "Памяти Кентаро Миуры"
	quest.495E4DC3E5C3CDF1.title: "Он просто хотел быть счастливым"
	quest.49FDA749FF226A36.quest_desc: ["Жидкости - неотъемлемая часть Create, трубы это главный транспорт."]
	quest.49FDA749FF226A36.quest_subtitle: "Скрафти жидкостную трубу"
	quest.49FDA749FF226A36.title: "Жидкостная логистика"
	quest.4A02D5111A0D3C58.quest_subtitle: "Скрафти предмет"
	quest.4A1CE02A8CDFBE67.quest_subtitle: "Скрафти предмет и собери ресурсы"
	quest.4B22E5A2BF69B16D.quest_desc: ["Открой для себя поезда, чтобы продвинуться дальше. Используй руководство Create для изучения."]
	quest.4BD8C5ED53F54778.quest_desc: ["Чугун - главный металл следующей эпохи, было бы неплохо автоматизировать его производство."]
	quest.4BD8C5ED53F54778.title: "Время е**ть чугун"
	quest.4BF5A98BFEAD801A.quest_desc: [
		"Настало время выжать немного электричества!"
		"Подай достаточное вращение на генератор и получи первую энергию."
	]
	quest.4C98927DAA52DC7F.quest_desc: ["Смотри руководство Create по добыче нефти."]
	quest.4CB77B02C3D9F611.quest_desc: ["Система автоматического приземления была бы полезна, так как гравитация штука коварная."]
	quest.4CB77B02C3D9F611.title: "Автопилот"
	quest.4D19E1E01976AD84.quest_desc: ["Шлюз необходим для взаимодействия конвейеров с сундуками."]
	quest.4D19E1E01976AD84.quest_subtitle: "Скрафти Андезитовый шлюз"
	quest.4D28F000605E910D.quest_subtitle: "Сделай 16 золотых яблок"
	quest.4D28F000605E910D.title: "Золотое яблочко"
	quest.4D4D55869576F8F4.quest_desc: ["Время открыть эффективную добычу руд."]
	quest.4D4D55869576F8F4.title: "Эффективная добыча!"
	quest.4EA96C4105BA6220.quest_desc: ["Осуществляет преобразование веществ между жидким и газообразным состояниями."]
	quest.4FD2DD0D135281F2.quest_desc: ["Туннели можно использовать для разделения потока предметов на контейнерах, или в декоративных целях, чтобы прикрыть ленту"]
	quest.4FD2DD0D135281F2.quest_subtitle: "Скрафти Андезитовый туннель"
	quest.510004A25926780F.quest_desc: ["Новый этап впереди... Пора сделать что-то более самоходное и автономное."]
	quest.510004A25926780F.title: "Моторизация!"
	quest.52E08F57342BCEEF.quest_desc: ["Важный элемент для производства сложных механизмов."]
	quest.53ECDA81CB4F0945.quest_subtitle: "Скрафти предмет"
	quest.5411392978609FB6.quest_desc: ["Многофункциональный блок, используется как декор для механизмов, а также часть крафтов. Можно скрафтить в мире, если расположить обтёсанное бревно и применить андезитовый сплав на ПКМ по блоку."]
	quest.5411392978609FB6.quest_subtitle: "Скрафти андезитовый корпус"
	quest.544475DE6AD9068F.quest_desc: ["Чтобы построить лунную базу необходим кислород, механизм который сможет насытить им атмосферу будет полезен для этого."]
	quest.544475DE6AD9068F.title: "Внеземной аванпост"
	quest.54B48BFDABFA447F.quest_desc: ["Отличный компонент для превращения в пластик или охлаждающую жидкость."]
	quest.54CA53F8D7CFC7A9.quest_subtitle: "Скрафти предмет и собери ресурсы"
	quest.5557BE22A06EC87F.quest_desc: ["Ключевой блок для запуска термоядерного реактора."]
	quest.55757CDFC7261717.quest_desc: ["Посещение Марса дало свои плоды, теперь технологии позволяют разлагать жидкости на другие полезные компоненты."]
	quest.55757CDFC7261717.title: "Электролиз!"
	quest.558485B090ABEF5F.quest_desc: ["I want to believe..."]
	quest.55905A6B196CF4FD.quest_desc: [
		"Шестерни бывают малые и большие, попробуй скрафтить несколько разных и поставь их рядом друг с другом."
		"Шестерни нужны чтобы передавать энергию вращения на механизмы."
	]
	quest.55905A6B196CF4FD.quest_subtitle: "Скрафти шестерню"
	quest.55905A6B196CF4FD.title: "Шестерни наше всё"
	quest.5628A65786589187.quest_desc: ["Пресс используется для производства пластин, а также других вещей. Может использоваться вместе с чашей."]
	quest.5669AFC31C5D8F85.quest_desc: ["Для управления ракетой нужна консоль."]
	quest.5669AFC31C5D8F85.title: "Пульт управления"
	quest.584873BAA34B165F.quest_desc: ["Основной строительный блок мультиблочной структуры термоядерного реактора."]
	quest.58AC2F204290EFF3.quest_desc: ["Управляющий элемент, который регулирует поток рабочей среды (пара, газа или жидкости) к турбине."]
	quest.59401A33CEB72479.quest_desc: ["Промышленный миксер необходим для смешивания различных компонентов."]
	quest.5988E85C489971C1.quest_desc: ["Обычно используется для более тонкой обработки ресурсов и подготовки их к дальнейшему использованию."]
	quest.5AE4B7F2817D73DF.quest_desc: ["Мозг космического шаттла, необходим для прокладывания маршрута в космосе."]
	quest.5AE4B7F2817D73DF.title: "Космический компьютер"
	quest.5B07D75D8155E1E5.quest_desc: ["Рёв дракона создал разлом, открыв пути в иные измерения. Мне следует подготовиться к путешествию."]
	quest.5B07D75D8155E1E5.quest_subtitle: "Собери предметы"
	quest.5B07D75D8155E1E5.title: "О мультивселенной мало что известно"
	quest.5B19E22DAC2D9ECF.quest_subtitle: "Скрафти предмет и убей мобов"
	quest.5C3ED35416EC3B76.quest_desc: ["Казалось бы, побочный продукт... Но при правильном использовании не хуже бензина."]
	quest.5D744BAA66F1D670.quest_desc: [
		"Простой кабель для передачи энергии между источниками и механизмами."
		"Может быть многократно улучшен."
	]
	quest.5E6FFD62E7A82C20.quest_subtitle: "Собери предметы"
	quest.5E6FFD62E7A82C20.title: "Я инженер, и я решаю проблемы"
	quest.5E8951EE6802C00F.quest_subtitle: "Скрафти предмет"
	quest.5E8D5402CF2106BF.quest_desc: ["Защитный корпус вокруг турбинного блока, удерживающий тепло и изолирующий внутренние компоненты."]
	quest.5E9FA0CF80514D4B.quest_desc: ["Модуль навигации позволяет отправляться на космическом судне на другие планеты солнечной системы."]
	quest.5E9FA0CF80514D4B.title: "Космическая навигация"
	quest.5F0E0D5A38AFEC63.quest_desc: ["                         ...here we go again."]
	quest.5F0E0D5A38AFEC63.quest_subtitle: "Скрафти предмет"
	quest.5F0E0D5A38AFEC63.title: "Ah shit..."
	quest.5F262DCF33DE434E.quest_desc: ["Время лететь на Марс."]
	quest.5F262DCF33DE434E.title: "Запустим DOOM в майнкрафте?"
	quest.5F343BA0CD11C42B.quest_desc: ["Лампы требуются для более сложных механизмов. Чтобы получить её, нужно обработать розовый кварц наждачной бумагой. Достаточно взять их в обе руки и нажать ПКМ."]
	quest.5FFBF375AD8DFACB.quest_subtitle: "Скрафти предмет"
	quest.5FFBF375AD8DFACB.title: "Разгоняемся!"
	quest.618D9A7E5A7CE580.quest_subtitle: "Скрафти предмет"
	quest.618D9A7E5A7CE580.title: "Удивительная пыль"
	quest.61A4E3A2B06F2106.quest_desc: ["Из воздуха можно вытягивать, так сильно необходимый в космосе, кислород."]
	quest.61A4E3A2B06F2106.title: "Кислородное голодание"
	quest.61F0162D3BF355E1.quest_desc: ["Я не могу приблизиться к звёздам, но может быть я хотя бы смогу взглянуть на них?"]
	quest.61F0162D3BF355E1.title: "Что ждёт нас среди звёзд?"
	quest.6231DA845C512E3C.quest_desc: ["Датчик кислорода позволит понять, можно ли дышать на местности."]
	quest.6231DA845C512E3C.title: "Анализатор атмосферы"
	quest.628C33F7C4717719.quest_desc: ["Медные провода служат для передачи электроэнергии между механизмами"]
	quest.628C33F7C4717719.title: "Медные провода"
	quest.62A2916E614748EC.quest_desc: ["Для получения вращения также можно использовать течение воды"]
	quest.62A2916E614748EC.quest_subtitle: "Создай водяное колесо"
	quest.62A2916E614748EC.title: "Сила воды"
	quest.62EEE37419B14CDD.quest_desc: [
		"Главный инструмент в Create, с его помощью можно настраивать механизмы."
		"Create также можно изучать нажимая кнопку W, наведя курсор на предметы из мода."
	]
	quest.62EEE37419B14CDD.quest_subtitle: "Получи гаечный ключ"
	quest.62EEE37419B14CDD.title: "Текноложиа!"
	quest.6379A6DFDE0A2FBF.quest_subtitle: "Получи алмазы"
	quest.6379A6DFDE0A2FBF.title: "Алмазы!"
	quest.6437B166F40AC730.quest_desc: ["Механизм для переплавки предметов за счёт энергии вместо топлива."]
	quest.6453A6F37A838527.quest_subtitle: "Посети Незер"
	quest.6453A6F37A838527.title: "В самое пекло"
	quest.65648957B98AC41F.quest_subtitle: "Скрафти предмет"
	quest.66B91938EABA769D.quest_desc: ["Интерфейс для запуска и контроля термоядерного реактора."]
	quest.67261087767CD39C.quest_desc: ["Время применить современные двигатели внутреннего сгорания! Смотри руководство Create."]
	quest.67496BCEDBA83DD6.quest_desc: ["Латунный корпус аналогичен андезитовому."]
	quest.67587C814004001C.quest_desc: ["Механический сборщик - это путь к автоматическому крафту. Также он открывает возможность крафтить сложные рецепты, требующие поле больше чем 3х3."]
	quest.677060423FC57715.quest_subtitle: "Скрафти предмет"
	quest.689F1EAF7C7934CF.quest_desc: ["Было бы неплохо записать расположение небесных тел."]
	quest.689F1EAF7C7934CF.title: "Они движутся?"
	quest.69B06ED3DF3D479E.quest_desc: ["Собрать все виды ванильной брони."]
	quest.69B06ED3DF3D479E.title: "Модник"
	quest.69F8F46A4759E72C.quest_desc: ["Используется как ключевой элемент в создании продвинутого ядерного топлива и термоядерных конструкций."]
	quest.6ACF8B4757B106A4.quest_desc: ["Механизм, который используется для создания некоторых улучшенных материалов."]
	quest.6B324581E92F39BE.quest_desc: ["Производство стали открывает новые горизонты."]
	quest.6B47BEA3DF0DEA83.quest_desc: ["Современные машины потребуют более совершенных компонентов для производства."]
	quest.6BD922313CC489C4.quest_desc: ["Суперклей можно использовать для создания многоблочных механизмов - \"штуковин\". В этом ты ограничен только своей фантазией."]
	quest.6E85BF3C40E0ABC6.quest_desc: ["Улучшение атомного разборщика, которое позволяет использовать модули для расширения функционала инструмента."]
	quest.6F649D9CF8AB8D9C.quest_desc: ["Латунный шлюз - улучшенная версия андезитового. Для него можно применить фильтр предметов, которые он будет пропускать через себя."]
	quest.6F649D9CF8AB8D9C.quest_subtitle: "Скрафти латунный шлюз"
	quest.711E961EF3238DB9.quest_desc: ["Свойства титана прекрасно позволяют использовать его для полётов за пределы атмосферы."]
	quest.711E961EF3238DB9.title: "Лёгкий и прочный"
	quest.71937D048B27AA94.quest_desc: ["Механический ремень надо расположить на валы. Он может выступать в качестве ленты конвейера, чтобы перемещать предметы и создавать производство, а также просто выступать в качестве передачи вращения на другие валы."]
	quest.71937D048B27AA94.quest_subtitle: "Создай механический ремень"
	quest.71937D048B27AA94.title: "Конвейер"
	quest.71B93F312FB0CA99.quest_subtitle: "Скрафти предмет"
	quest.72D62C57A5ACA599.quest_desc: ["Устройство для быстрой передачи предметов между механизмами."]
	quest.732DED13D841C482.quest_desc: ["Латунь второй на очереди из самых важных материалов Create, который позволяет открыть для себя новые механизмы"]
	quest.7535D7381A03FF31.quest_desc: [
		"Компактный накопитель энергии для первых механизмов."
		"Может быть многократно улучшен."
	]
	quest.7557D2D4C4F29BC6.quest_desc: [
		"Природные источники энергии хороши, но энергия пара ещё лучше!"
		"Чтобы двигатель заработал, нужно сделать бойлер. Расположи жидкостные баки над кострами и поставь двигатель на одну из сторон. Чтобы окончательно собрать двигатель, нужно поставить вал, на который передастся вращение."
	]
	quest.7557D2D4C4F29BC6.quest_subtitle: "Скрафти паровой двигатель"
	quest.76C2A3C1E5B0B589.quest_desc: [
		"Алмазы начали вести себя неестественно, если бросить его в яму с водой, которая окружена цветами - произойдёт аномалия... "
		"Яма должна быть 2х2."
	]
	quest.76C2A3C1E5B0B589.title: "Иное измерение"
	quest.77070EC1A8F649D1.quest_desc: ["Поляризатор позволяет делать новые магниты!"]
	quest.7742E1D753D37541.quest_desc: [
		"Инструмент для настройки сторон и режимов работы в Mekanism."
		"С его помощью можно точно задать, как устройство будет принимать, передавать или обрабатывать ресурсы."
	]
	quest.77B82176648BEDDF.quest_desc: ["Механизм, который вырабатывает энергию, сжигая газы, такие как этилен или водород."]
	quest.78604B65A0A1BB11.quest_desc: ["Этот квест можно повторять, чтобы фармить опыт."]
	quest.78604B65A0A1BB11.quest_subtitle: "Убей заданное количество мобов"
	quest.78604B65A0A1BB11.title: "Выживал среди зомбаков"
	quest.78B9485CA7360F1D.quest_desc: ["Стоит понаблюдать за луной несколько ночей и каждый раз записывать где она находится."]
	quest.78B9485CA7360F1D.quest_subtitle: "Запиши 3 раза координаты луны, лучше делать это в разные ночи"
	quest.78B9485CA7360F1D.title: "Звёздная карта"
	quest.79962CCAAD5F506D.quest_desc: ["Прочная структура, в которой собирается активная зона и рабочие элементы ядерного реактора."]
	quest.79EE408C8D241D6B.quest_desc: ["Позволяет быстро заготавливать большие объёмы сырья без разрушения территории и строительства шахт вручную."]
	quest.7A40C97FDCE7BC06.quest_desc: ["Create открывает новые возможности для железных дорог!"]
	quest.7B1632BA15E76648.quest_desc: ["Не лететь же в космос голым?"]
	quest.7B1632BA15E76648.title: "Самый модный в пустоте"
	quest.7B375A31B722B63C.quest_desc: ["Костёр недостаточный источник тепла, для того чтобы выработать много энергии. Поймай всполоха в горелку и поставь его под бойлер. Такие горелки также могут понадобиться в дальнейшем для крафтов."]
	quest.7B375A31B722B63C.quest_subtitle: "Поймай всполоха в горелку"
	quest.7C1CB59BAFE70B41.quest_desc: ["Умная версия жёлоба, умеет фильтровать предметы"]
	quest.7C1CB59BAFE70B41.quest_subtitle: "Скрафти умный жёлоб"
	quest.7CB68D2BE3CF7F22.quest_desc: ["Коксовая печь требуется для получения коксового угля и креозота. Смотри руководство Create. Не забудь выводить выхлопные газы"]
	quest.7D336B3EC0CAD3C7.quest_desc: ["Пора развивать переработку!"]
	quest.7DC644B7D8729ED0.quest_desc: ["Дозатор позволяет разливать жидкости в ёмкости или на конвейер."]
	quest.7DC644B7D8729ED0.quest_subtitle: "Скрафти дозатор"
	quest.7E20912C5427FCDE.quest_desc: ["Литий = хранение энергии. Из него получаются аккумуляторы."]
	quest.7E5C0D521D7E2D0E.quest_desc: [
		"А вот и первые трудности. "
		"В мире накапливается загрязнение, поэтому такие вещи как печки лучше ставить снаружи."
		"Или на крайний случай выводить дым наружу."
	]
	quest.7E5C0D521D7E2D0E.quest_subtitle: "Создай металлический дымоход"
	quest.7E5C0D521D7E2D0E.title: "Братух, чем воняет?"
